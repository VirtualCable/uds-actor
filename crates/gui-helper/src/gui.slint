import { Button, VerticalBox, AboutSlint } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: root.title_text;
    min-width: 400px;
    min-height: 150px;
    
    in-out property <string> title_text: "Message";
    in-out property <string> message_text: "";
    property <bool> show_about: false;
    
    callback ok_clicked();

    VerticalBox {
        padding: 20px;
        spacing: 20px;
        alignment: center;

        Text {
            text: root.message_text;
            wrap: word-wrap;
            font-size: 14px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            Button {
                text: "OK";
                width: 100px;
                height: 30px;
                clicked => { root.ok_clicked(); }
            }
        }

        Text {
            text: "About";
            color: #0055aa;
            font-size: 11px;
            horizontal-alignment: center;

            about-link := TouchArea {
                width: 80px;
                clicked => { root.show_about = !root.show_about; }
            }
        }
        if root.show_about: AboutSlint {
            height: 120px;
        }
    }
}
